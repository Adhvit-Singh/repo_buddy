# repo_buddy backend — copy to `.env` and fill in what you need.
#   cp .env.example .env        (Windows: copy .env.example .env)
# Never commit `.env`.

# ── Required ───────────────────────────────────────────────
# Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ── URLs ───────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
# Extra CORS origins, comma-separated (localhost:3000 is always allowed)
ALLOWED_ORIGINS=""

# ── Optional: GitHub sign-in (needed for dashboard + auto-fix PRs) ──
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: <BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional: push-triggered scans ─────────────────────────
# Secret you also paste into the repo's GitHub webhook settings
GITHUB_WEBHOOK_SECRET=""

# ── Optional: models (override when a provider retires one) ──
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# LLM_TIMEOUT_SECONDS="120"
# Anthropic is tried first when a key is set; Gemini is the fallback.
ANTHROPIC_API_KEY=""

# ── Optional: alerts ───────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SLACK_WEBHOOK_URL=""

# ── Optional: storage ──────────────────────────────────────
# DATABASE_PATH="/data/repo_buddy.db"
